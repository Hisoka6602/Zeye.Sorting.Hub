# Copy to deploy/.env and set unique local secrets before starting Compose.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-unique-value
MYSQL_PASSWORD=replace-with-a-different-strong-unique-value
ZEYE_WEB_PORT=4187
ZEYE_API_PORT=5087
# Keep all Linux containers on the same business-local time zone.
ZEYE_TIME_ZONE=Asia/Shanghai
# Built-in authentication. Use a unique initialization key, then create an admin on /access/login.
ZEYE_AUTH_ENABLED=true
ZEYE_BOOTSTRAP_KEY=replace-with-a-strong-unique-initialization-key
# Legacy HTTP processing endpoint only. SignalR Fusion uses an independent key for each registered source.
ZEYE_MACHINE_API_KEY=replace-with-a-different-machine-api-key
# Stable Hub identity; must match Fusion's target HubId.
ZEYE_FUSION_HUB_ID=sorting-hub
# Optional discovery overlay defaults to localhost. Set the specific LAN interface when enabling discovery.
ZEYE_FUSION_UDP_BIND=127.0.0.1

# HTTP Outbox delivery; leave the endpoint empty to keep messages pending.
# Use a distinct stable source for each database/environment.
