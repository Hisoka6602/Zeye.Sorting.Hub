<Project Sdk="Microsoft.NET.Sdk.Web">

	<!-- 中文说明：服务宿主的构建、依赖与发布配置。 -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>dotnet-Zeye.Sorting.Hub.Host-6c5f01b5-c5a0-403c-b3c3-bf396b712902</UserSecretsId>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
		<!-- 发布默认包含同源前端；仅 API 镜像可显式设为 false。 -->
		<BundleWebUi Condition="'$(BundleWebUi)' == ''">true</BundleWebUi>
		<RestoreWebDependencies Condition="'$(RestoreWebDependencies)' == ''">true</RestoreWebDependencies>
		<ForceWebUiBuild Condition="'$(ForceWebUiBuild)' == ''">false</ForceWebUiBuild>
		<ForceWebDependencyRestore Condition="'$(ForceWebDependencyRestore)' == ''">false</ForceWebDependencyRestore>
		<WebNpmRegistry Condition="'$(WebNpmRegistry)' == ''">https://registry.npmjs.org/</WebNpmRegistry>
		<WebNpmFallbackRegistry Condition="'$(WebNpmFallbackRegistry)' == ''">https://registry.npmmirror.com/</WebNpmFallbackRegistry>
		<WebUiRoot>$(MSBuildProjectDirectory)/../Zeye.Sorting.Hub.Web</WebUiRoot>
	</PropertyGroup>

	<ItemGroup>
		<!-- EF CLI以Host为启动项目生成SQL Server专用迁移。 -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.14">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="NLog" Version="6.1.1" />
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.12" />
		<PackageReference Include="NLog.Extensions.Logging" Version="6.1.2" />
		<PackageReference Include="Polly" Version="8.6.5" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
	</ItemGroup>

	<ItemGroup>
		<!-- dotnet 工具清单仅用于开发，禁止作为运行配置复制到构建或发布目录。 -->
		<Content Update="dotnet-tools.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
		<Content Update="nlog.config">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Start-Hub.cmd" CopyToPublishDirectory="PreserveNewest" />
		<!-- 安装与卸载入口随 Windows / Linux 的一体化发布包一起交付。 -->
		<Content Include="install.bat;uninstall.bat;install.sh;uninstall.sh;service.ps1;service.sh" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Zeye.Sorting.Hub.Application\Zeye.Sorting.Hub.Application.csproj" />
		<ProjectReference Include="..\Zeye.Sorting.Hub.Contracts\Zeye.Sorting.Hub.Contracts.csproj" />
		<ProjectReference Include="..\Zeye.Sorting.Hub.Domain\Zeye.Sorting.Hub.Domain.csproj" />
		<ProjectReference Include="..\Zeye.Sorting.Hub.Infrastructure\Zeye.Sorting.Hub.Infrastructure.csproj" />
		<ProjectReference Include="..\Zeye.Sorting.Hub.Infrastructure.SqlServerMigrations\Zeye.Sorting.Hub.Infrastructure.SqlServerMigrations.csproj" />
		<ProjectReference Include="..\Zeye.Sorting.Hub.Infrastructure.OracleMigrations\Zeye.Sorting.Hub.Infrastructure.OracleMigrations.csproj" />
		<ProjectReference Include="..\Zeye.Sorting.Hub.Infrastructure.SqliteMigrations\Zeye.Sorting.Hub.Infrastructure.SqliteMigrations.csproj" />
		<ProjectReference Include="..\Zeye.Sorting.Hub.SharedKernel\Zeye.Sorting.Hub.SharedKernel.csproj" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>Zeye.Sorting.Hub.Host.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<!-- 前端按内容增量构建，完整产物纳入标准发布清单；目标机只运行 Host。 -->
	<Target Name="PublishBundledWebUi" AfterTargets="ComputeFilesToPublish" Condition="'$(BundleWebUi)' == 'true'">
		<Exec WorkingDirectory="$(WebUiRoot)"
			Command="node scripts/publish-web-ui.mjs --restore-dependencies &quot;$(RestoreWebDependencies)&quot; --force-build &quot;$(ForceWebUiBuild)&quot; --force-restore &quot;$(ForceWebDependencyRestore)&quot; --registry &quot;$(WebNpmRegistry)&quot; --fallback-registry &quot;$(WebNpmFallbackRegistry)&quot;" />
		<Error Condition="!Exists('$(WebUiRoot)/dist/index.html')" Text="前端构建未生成 index.html，不能发布不完整的前后端程序。" />
		<ItemGroup>
			<_BundledWebFile Include="$(WebUiRoot)/dist/**/*" />
			<ResolvedFileToPublish Include="@(_BundledWebFile)" Exclude="@(ResolvedFileToPublish)">
				<RelativePath>wwwroot/%(_BundledWebFile.RecursiveDir)%(_BundledWebFile.Filename)%(_BundledWebFile.Extension)</RelativePath>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
				<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			</ResolvedFileToPublish>
		</ItemGroup>
	</Target>
	<!-- SDK 按时间和大小跳过复制；此步骤确保同大小、同时间戳的损坏资源也被修复。 -->
	<Target Name="CopyBundledWebUiToPublishDirectory" AfterTargets="Publish" Condition="'$(BundleWebUi)' == 'true'">
		<Copy SourceFiles="@(_BundledWebFile)" DestinationFiles="@(_BundledWebFile->'$(PublishDir)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" />
	</Target>
</Project>
