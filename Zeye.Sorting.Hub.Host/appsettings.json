{
  // 仅保留建立配置存储所必需的启动信息；其他设置由 LiteDB 管理。
  "ConfigurationStorage": {
    // 可填写范围：LiteDB；旧 JSON 配置自动导入此存储。
    "Provider": "LiteDB",
    // 可填写范围：绝对路径或相对于配置根目录的路径，目录及文件自动创建。
    "LiteDbPath": "data/configuration/settings.db",
    // 可填写范围：独立的 SQLite 文件路径，不能与 LiteDB 使用相同文件。
    "HistorySqlitePath": "data/business-history/configuration-history.db",
    // 可填写范围：1~60 秒，检测其他进程对同一 LiteDB 的修改。
    "ReloadIntervalSeconds": 1
  }
}
