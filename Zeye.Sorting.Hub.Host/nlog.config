<?xml version="1.0" encoding="utf-8" ?>
<!--
  NLog 配置 — 应用、数据库与异常独立落盘
  ─────────────────────────────────────────────────────────────────────
  日志落盘策略：
    logs/app-<yyyy-MM-dd>.log     应用日志
    logs/database-<yyyy-MM-dd>.log 数据库专属日志（EF Core 迁移、
                                  DatabaseInitializerHostedService、
                                  DatabaseAutoTuningHostedService、
                                  Persistence 层）
    logs/exceptions-<yyyy-MM-dd>.log 全部携带异常的日志及 Warning 以上日志
    路径始终基于程序目录；归档数量与 LogCleanup 保留天数共同约束保留窗口。

  轮转规则：
    - 单文件大小上限 10 MB（archiveAboveSize="10485760"），超过立即轮转
    - 每天同时触发一次归档（archiveEvery="Day"）
    - 归档编号使用 DateAndSequence，支持同天多次轮转（如 app-20240101.1.log）
    - maxArchiveFiles="30" 限制归档文件数量（非天数）；日志量较大时实际保留天数可能少于 30 天

  低开销设计：
    - AsyncWrapper + Grow    异步批量写入，队列溢出时扩展而不丢弃日志
    - keepFileOpen="true"     保持文件句柄常开，避免每行日志重复 open/close
    - 异常独立规则先执行，Debug 级异常也不会被普通 Info 规则过滤。
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      throwConfigExceptions="true"
      internalLogLevel="Warn"
      internalLogToConsoleError="true">

  <!-- 默认日志目录是程序所在目录下的 logs，不受服务工作目录影响。 -->
  <variable name="logDirectory" value="${basedir}/logs" />

  <targets>
    <default-wrapper xsi:type="AsyncWrapper" queueLimit="10000" overflowAction="Grow" batchSize="200" />

    <!-- 控制台输出；异常仍须同时写入文件。 -->
    <target xsi:type="Console"
            name="console"
            layout="${longdate} [${level:uppercase=true:padding=-5}] [${logger:shortName=true}] ${message}${onexception:inner=${newline}${exception:format=tostring}}" />

    <!-- 普通应用日志：Info 及以上，数据库日志由专属规则分流。 -->
    <target xsi:type="File"
            name="app-file"
            fileName="${var:logDirectory}/app-${shortdate}.log"
            layout="${longdate} [${level:uppercase=true:padding=-5}] [${logger}] ${message}${onexception:inner=${newline}${exception:format=tostring}}"
            keepFileOpen="true"
            archiveEvery="Day"
            archiveAboveSize="10485760"
            archiveFileName="${var:logDirectory}/archive/app-{#}.log"
            archiveNumbering="DateAndSequence"
            archiveDateFormat="yyyyMMdd"
            maxArchiveFiles="30" />

    <!-- 数据库专属日志：仅记录与数据库初始化、迁移、EF Core、AutoTuning 相关日志 -->
    <target xsi:type="File"
            name="database-file"
            fileName="${var:logDirectory}/database-${shortdate}.log"
            layout="${longdate} [${level:uppercase=true:padding=-5}] [${logger}] ${message}${onexception:inner=${newline}${exception:format=tostring}}"
            keepFileOpen="true"
            archiveEvery="Day"
            archiveAboveSize="10485760"
            archiveFileName="${var:logDirectory}/archive/database-{#}.log"
            archiveNumbering="DateAndSequence"
            archiveDateFormat="yyyyMMdd"
            maxArchiveFiles="30" />

    <!-- 独立异常文件保留完整堆栈、内部异常及调用关联信息。 -->
    <target xsi:type="File"
            name="exception-file"
            fileName="${var:logDirectory}/exceptions-${shortdate}.log"
            layout="${longdate} [${level:uppercase=true:padding=-5}] [${logger}] TraceId=${event-properties:item=TraceId} ActivityTraceId=${scopeproperty:item=TraceId} ConnectionId=${event-properties:item=ConnectionId} Method=${event-properties:item=Method} ${message}${onexception:inner=${newline}${exception:format=tostring}}"
            keepFileOpen="true"
            autoFlush="true"
            archiveEvery="Day"
            archiveAboveSize="10485760"
            archiveFileName="${var:logDirectory}/archive/exceptions-{#}.log"
            archiveNumbering="DateAndSequence"
            archiveDateFormat="yyyyMMdd"
            maxArchiveFiles="30" />

  </targets>

  <rules>
    <!-- 必须位于所有 final 规则之前；无异常的低级别调试信息不进入异常文件。 -->
    <logger name="*" minlevel="Trace" writeTo="exception-file">
      <filters defaultAction="Ignore">
        <when condition="'${exception:format=type}' != ''" action="Log" />
        <when condition="level &gt;= LogLevel.Warn" action="Log" />
      </filters>
    </logger>
    <!-- 数据库相关日志只写入 database-file；final 避免再次命中全量规则造成双写。 -->
    <logger name="Zeye.Sorting.Hub.Host.HostedServices.DatabaseInitializerHostedService"
            minlevel="Info" writeTo="database-file" final="true" />
    <logger name="Zeye.Sorting.Hub.Host.HostedServices.DatabaseAutoTuningHostedService"
            minlevel="Info" writeTo="database-file" final="true" />
    <logger name="Microsoft.EntityFrameworkCore.*"
            minlevel="Info" writeTo="database-file" final="true" />
    <logger name="Zeye.Sorting.Hub.Infrastructure.Persistence.*"
            minlevel="Info" writeTo="database-file" final="true" />

    <!-- 全量应用日志：所有分类写入控制台 + app-file -->
    <logger name="*" minlevel="Info" writeTo="console,app-file" />
  </rules>

</nlog>
