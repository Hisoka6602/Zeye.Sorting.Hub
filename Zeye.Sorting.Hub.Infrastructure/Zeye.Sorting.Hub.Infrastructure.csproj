<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="9.0.14" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <Folder Include="Auth\" />
    <Folder Include="Repositories\Parcel\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\default-settings*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.Sharding.MySql" Version="9.0.10" />
    <PackageReference Include="EFCore.Sharding.SqlServer" Version="9.0.10" />
    <PackageReference Include="EFCore.Sharding.Oracle" Version="9.0.10" />
    <PackageReference Include="EFCore.Sharding.SQLite" Version="9.0.10" />
    <PackageReference Include="Oracle.EntityFrameworkCore" Version="9.23.26100" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Minio" Version="7.0.0" />
    <PackageReference Include="NLog" Version="6.1.1" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <!-- 覆盖 EFCore.Sharding.MySql 9.0.10 引入的旧版本传递依赖，使其与 EF Core 9 对齐 -->
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql.NetTopologySuite" Version="9.0.0" />
    <!-- 覆盖 Oracle 驱动引入的 Pkcs 8.0.1；宿主裁剪框架内 Xml 引用后仍需保留安全版本。 -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- 覆盖 System.ServiceModel.Primitives 引入的漏洞版本，使用 2026 年 10 月安全补丁。 -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zeye.Sorting.Hub.Application\Zeye.Sorting.Hub.Application.csproj" />
    <ProjectReference Include="..\Zeye.Sorting.Hub.Domain\Zeye.Sorting.Hub.Domain.csproj" />
    <ProjectReference Include="..\Zeye.Sorting.Hub.SharedKernel\Zeye.Sorting.Hub.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Zeye.Sorting.Hub.Host.Tests" />
  </ItemGroup>

</Project>
